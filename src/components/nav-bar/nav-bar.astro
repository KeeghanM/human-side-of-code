---
import { Image } from 'astro:assets'
import PitchDialog from '../pitch-dialog/index.astro'
const links = [
  { href: '/', label: 'Home' },
  { href: '/articles', label: 'Articles' },
  { href: '/about', label: 'About' },
]
---

<header
  class="nav-bar bg-background-50 sticky top-0 z-50 flex items-center justify-between px-4 py-2 shadow-md"
>
  <div class="flex max-w-7xl mx-auto w-full px-4">
    <a href="/">
      <Image
        src="/husoc-logo.svg"
        alt="HuSOC: Human Side of Code"
        aria-hidden="true"
        width="200"
        height="200"
        loading="eager"
      />
    </a>
    <nav class="flex-grow flex justify-center items-center">
      <ul class="flex space-x-4">
        {
          links.map((link) => (
            <li>
              {link.label === 'About' ? (
                <PitchDialog />
              ) : (
                <a
                  class="text-text-800 hover:text-primary uppercase font-bold text-xl"
                  href={link.href}
                  aria-label={link.label}
                >
                  {link.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <script>
    const navBar = document.querySelector('.nav-bar') as HTMLHeadingElement
    const logo = navBar.querySelector('img') as HTMLImageElement
    const logoWidth = logo.width
    const logoHeight = logo.height

    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY
      const newHeight = Math.max(80, logoHeight - scrollY / 2)
      const newWidth = (newHeight / logoHeight) * logoWidth
      logo.width = newWidth
      logo.height = newHeight
    })
  </script>
</header>
