---
import Heading from "../ui/heading.astro";
import Section from "../ui/section.astro";
import SignUp from "./sign-up";
---

<Section>
  <Heading level={2} text="Sign up to the newsletter" />
  <p>
    If you want to stay updated with my latest articles, signup below. We won't
    use the newsletter for anything other than notifying you of new content.
    Promise.
  </p>
  <SignUp client:visible />
</Section>
