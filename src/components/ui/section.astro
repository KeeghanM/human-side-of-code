---
import tc from "tailcomp";

interface Props {
  bg?: "accent" | "secondary";
}
const { bg } = Astro.props;
const classes = tc({
  base: {
    static: {
      "p-4 md:p-6": true,
      "bg-accent/10": bg === "accent",
      "bg-secondary/10": bg === "secondary",
    },
  },
});
---

<section class={classes}>
  <div class="lg:max-w-screen-lg">
    <slot />
  </div>
</section>
