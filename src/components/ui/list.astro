---
import { type Icon as IconType } from "@lucide/astro";

interface Props {
  items: {
    icon: typeof IconType;
    text: string;
  }[];
  theme: "primary" | "secondary" | "accent";
}
const { items, theme } = Astro.props;
---

<ul class="text-sm">
  {
    items.map((item) => (
      <li class="flex items-center gap-2 p-2">
        <item.icon color={`var(--color-${theme})`} />
        <span>{item.text}</span>
      </li>
    ))
  }
</ul>
