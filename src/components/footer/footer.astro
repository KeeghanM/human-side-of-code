---
import Section from "../ui/section.astro";
---

<Section theme="dark">
  <div class="flex items-center gap-2 justify-center flex-col">
    <p>Created by Keeghan McGarry</p>
    <div class="flex items-center gap-2 justify-center">
      <a
        aria-label="Portfolio"
        href="https://keeghan.io"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 32 32"
          ><path
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M29 17v11H3V17M2 8h28v8s-6 4-14 4s-14-4-14-4zm14 14v-4m4-10s0-4-4-4s-4 4-4 4"
          ></path></svg
        >
      </a>
      <a
        aria-label="GitHub"
        href="https://github.com/KeeghanM"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          ><g fill="none"
            ><g clip-path="url(#akarIconsGithubFill0)"
              ><path
                fill="currentColor"
                fill-rule="evenodd"
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385c.6.105.825-.255.825-.57c0-.285-.015-1.23-.015-2.235c-3.015.555-3.795-.735-4.035-1.41c-.135-.345-.72-1.41-1.23-1.695c-.42-.225-1.02-.78-.015-.795c.945-.015 1.62.87 1.845 1.23c1.08 1.815 2.805 1.305 3.495.99c.105-.78.42-1.305.765-1.605c-2.67-.3-5.46-1.335-5.46-5.925c0-1.305.465-2.385 1.23-3.225c-.12-.3-.54-1.53.12-3.18c0 0 1.005-.315 3.3 1.23c.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23c.66 1.65.24 2.88.12 3.18c.765.84 1.23 1.905 1.23 3.225c0 4.605-2.805 5.625-5.475 5.925c.435.375.81 1.095.81 2.22c0 1.605-.015 2.895-.015 3.3c0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12"
                clip-rule="evenodd"></path></g
            ><defs
              ><clipPath id="akarIconsGithubFill0"
                ><path fill="#fff" d="M0 0h24v24H0z"></path></clipPath
              ></defs
            ></g
          ></svg
        >
      </a>
      <a
        aria-label="LinkedIn"
        href="https://www.linkedin.com/in/keeghan-mcgarry/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 128 128"
          ><path
            fill="currentColor"
            d="M116 3H12a8.91 8.91 0 0 0-9 8.8v104.42a8.91 8.91 0 0 0 9 8.78h104a8.93 8.93 0 0 0 9-8.81V11.77A8.93 8.93 0 0 0 116 3M39.17 107H21.06V48.73h18.11zm-9-66.21a10.5 10.5 0 1 1 10.49-10.5a10.5 10.5 0 0 1-10.54 10.48zM107 107H88.89V78.65c0-6.75-.12-15.44-9.41-15.44s-10.87 7.36-10.87 15V107H50.53V48.73h17.36v8h.24c2.42-4.58 8.32-9.41 17.13-9.41C103.6 47.28 107 59.35 107 75z"
          ></path></svg
        >
      </a>
    </div>
  </div>
</Section>
