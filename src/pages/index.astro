---
import SignUp from '../components/sign-up/sign-up.tsx'
import Content from '../components/content/content.astro'
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout
  seo={{
    title: 'Human Side of Code',
    description:
      'Bridging technical expertise and human-centred development in the tech industry.',
  }}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Human Side of Code',
    url: 'https://humansideofcode.com',
    description:
      'Bridging technical expertise and human-centred development in the tech industry.',
  }}
>
  <section class="sign-up">
    <h2>Sign up to be notified when we launch our first content!</h2>
    <SignUp client:visible />
  </section>
  <Content />
</MainLayout>
<style>
  .sign-up {
    text-align: center;
    width: fit-content;
    margin: auto;
    margin-bottom: 1rem;

    h2 {
      font-size: 1rem;
    }
  }
</style>
