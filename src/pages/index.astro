---
import MainLayout from "../layouts/MainLayout.astro";
import { ArticleOrderByInput, query } from "../lib/graphql-api";
import { hygraphRequest } from "../lib/hygraph-client";

const latestArticleQuery = query((q) => [
  q
    .articles(
      { first: 1, orderBy: ArticleOrderByInput.publishedAt_DESC },
      (a) => [a.slug],
    )
    .as("latestArticles"),
]);
const latestArticleData = await hygraphRequest(latestArticleQuery);
const { latestArticles } = latestArticleData;
---

<MainLayout
  seo={{
    title: "Human Side of Code",
    description:
      "Even the most elegant code is written by humans, for humans. Practical communication skills and career advice to help software engineers excel beyond just coding proficiency.",
  }}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Human Side of Code",
    url: "https://www.humansideofcode.com",
    description:
      "Even the most elegant code is written by humans, for humans. Practical communication skills and career advice to help software engineers excel beyond just coding proficiency.",
  }}
/>
