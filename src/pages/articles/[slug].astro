---
import { hygraphRequest } from '../../lib/hygraph-client.ts'
import { query } from '../../lib/graphql-api.ts'
import MainLayout from '../../layouts/MainLayout.astro'
import Newsletter from '../../components/sign-up/newsletter.astro'
export async function getStaticPaths() {
  // Fetch all articles to generate static paths
  // This is a simple query to get all articles with their slugs
  const articlesQuery = query((q) => [q.articles({}, (a) => [a.slug])])
  const articles = await hygraphRequest(articlesQuery)

  // This will return an array of objects with the slug of each article
  // This is used to generate static paths for each article
  return [
    ...articles.articles.map((article) => ({
      params: { slug: article.slug },
    })),
  ]
}

// This function will run at build time to generate the static page for each article
const { slug } = Astro.params
const articleQuery = query((q) => [
  q.article({ where: { slug } }, (a) => [
    a.title,
    a.content((c) => [c.html, c.text]),
    a.publishedAt,
  ]),
])

const articleResponse = await hygraphRequest(articleQuery)

// Check if the article exists, if not redirect to 404 page
if (!articleResponse.article) {
  return Astro.redirect('/404')
}
const { article } = articleResponse

const { title, content, publishedAt } = article
---

<MainLayout
  seo={{
    title: title,
    description: content.text.substring(0, 150) + '...',
    canonical: `/articles/${slug}`,
  }}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    'headline': title,
    'datePublished': publishedAt,
    'articleBody': content.text,
  }}
>
  <main class='mx-auto max-w-3xl py-8 px-4 select-none'>
    <h1 class='text-3xl font-bold text-primary-500'>{title}</h1>
    {
      publishedAt && (
        <p class='text-sm text-accent-700 italic'>
          Published on {new Date(publishedAt).toLocaleDateString('en-GB')}
        </p>
      )
    }
    <article
      set:html={content.html}
      class='mt-4 mb-24 leading-relaxed'
    />
  </main>
  <Newsletter />
</MainLayout>

<style is:inline>
  article > * + * {
    margin-top: 1.2em;
  }

  article h2 {
    font-size: 1.5rem;
    font-weight: bold;
  }

  article h3 {
    font-size: 1.25rem;
    font-weight: bold;
  }

  article h4 {
    font-size: 1.125rem;
    font-weight: bold;
  }

  article a {
    color: var(--color-primary);
  }

  article ul {
    list-style: disc;
    padding-left: 1.5rem;
  }

  article ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }
</style>
