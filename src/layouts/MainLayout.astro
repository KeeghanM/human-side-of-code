---
// import { Head } from 'astro-capo'
import { SEO, type SEOProps } from 'astro-seo'
import { Schema, type SchemaProps } from 'astro-seo-schema'
import Posthog from '../components/posthog.astro'

import './src/styles/global.css'
import { ClientRouter } from 'astro:transitions'
interface Props {
  seo: SEOProps
  schema?: SchemaProps<any>['item']
}

const { seo, schema } = Astro.props
seo.title = seo.title || 'Human Side of Code'
seo.description =
  seo.description ||
  'Bridging technical expertise and human-centred development in the tech industry.'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <SEO {...seo} />
    {schema && <Schema item={schema} />}
    <Posthog />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <ClientRouter />
  </head>
  <body>
    <header>
      <a href="/">
        <img
          src="/husoc-logo.svg"
          alt=""
          aria-hidden="true"
          width="300"
          height="300"
          loading="eager"
        />
      </a>
    </header>
    <slot />
  </body>
</html>

<style>
  header {
    display: flex;
    justify-content: center;
    a {
      text-align: center;

      img {
        width: 100%;
        max-width: 300px;
      }
    }
  }
</style>
