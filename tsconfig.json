{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "baseUrl": ".",
  "paths": {
    "@cms/*": ["src/hygraph/graphql/*"],
    "@components/*": ["src/components/*"],
    "@lib/*": ["src/lib/*"]
  },
  "exclude": ["node_modules", "src/hygraph", "src/lib/graphql-api.ts"]
}
