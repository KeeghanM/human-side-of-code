{
  "name": "husoc",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:graphql-schema": "npx graphql-codegen --config codegen.ts",
    "generate:typed-graphql": "npx typed-graphql-builder --schema ./graphql/schema.graphql --output ./src/graphql-api.ts",
    "generate:migration": "node --loader ts-node/esm src/hygraph/create-migration.ts",
    "migrate:hygraph": "node --loader ts-node/esm src/hygraph/migration-runner.ts"
  },
  "dependencies": {
    "@astrojs/node": "^9.2.1",
    "@astrojs/react": "^4.2.6",
    "@hygraph/management-sdk": "^1.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "astro": "^5.7.9",
    "astro-compress": "^2.3.8",
    "astro-purgecss": "^5.2.2",
    "astro-seo": "^0.8.4",
    "astro-seo-schema": "^5.0.0",
    "graphql-request": "^7.1.2",
    "purgecss": "^7.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.87.0",
    "schema-dts": "^1.1.5",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-tools/url-loader": "^8.0.31",
    "dotenv": "^16.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
